TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here

# Optional comma-separated list. If empty, Pulse Desk finds *.session files automatically.
# Do not reuse the same *.session files on two IP addresses at the same time.
# On a second IP, set a separate PULSE_SESSION_DIR and use separate session names,
# for example TELEGRAM_SESSIONS=alga_kazakhst2n_ip2,w3v8f0rm_ip2.
TELEGRAM_SESSIONS=alga_kazakhst2n,w3v8f0rm,Fjfjfjfjds,MuverGT,Timofey02513,xdfusybau,davifd23,fsdfsdfdsg34

# Usernames to track, with or without @. Account session names go in TELEGRAM_SESSIONS, not here.
USERNAMES=alga_kazakhst2n,w3v8f0rm,Fjfjfjfjds,Timofey02513,MuverGT,xdfusybau,davifd23,fsdfsdfdsg34
EXTRA_USERNAMES=

# Optional Telegram bot notifications.
TELEGRAM_BOT_TOKEN=
ADMIN_ID=
# Extra owner chat ids with full bot control (comma-separated). ADMIN_ID is always an owner.
# Other people get read-only access via access keys (/newkey in the bot or the web panel).
BOT_ADMIN_CHATS=
# Send on-brand Aperture stickers on key bot events (win/scan/check/ping/etc). Default on.
BOT_STICKERS_ENABLED=true
# Short name of the Aperture custom-emoji pack (create via @Stickers, needs Premium).
# When set, the bot renders its 🏆🎁💸… as branded custom emoji inline (Premium
# users see them custom; everyone else sees the same standard emoji). Empty = off.
BOT_CUSTOM_EMOJI_SET=

# Access tokens.
# ADMIN_TOKEN can manage accounts, settings, scans, logs and exports.
# VIEWER_TOKEN can only view dashboard, pings, market and analytics.
# WEB_AUTH_TOKEN is kept for old installs and acts like ADMIN_TOKEN if ADMIN_TOKEN is empty.
# Use long different random values. Send only VIEWER_TOKEN to friends.
ADMIN_TOKEN=change-this-owner-token
VIEWER_TOKEN=change-this-friend-token
WEB_AUTH_TOKEN=
PUBLIC_SHARE_MODE=true
ALLOW_QUERY_TOKEN=false

# Keep local app bound to localhost. Share it through Cloudflare Quick Tunnel/ngrok.
HOST=127.0.0.1
PORT=8000

# Safety defaults.
GIVEAWAY_ACTION_ACCOUNT=alga_kazakhst2n
GIVEAWAY_REVIEW_MODE=manual
GIVEAWAY_ANALYZE_RECENT_MESSAGES=50
GIVEAWAY_INACTIVE_CHANNEL_DAYS=14
GIVEAWAY_MIN_ACTION_DELAY_SECONDS=45

# Background jobs.
SCAN_INTERVAL_SECONDS=900
SCAN_ACCOUNT_CONCURRENCY=3
# 0 means no per-username history cap.
SCAN_HISTORY_LIMIT=0
# Recent channel posts checked again on every background scan to catch edited winner posts.
# 0 disables the edited-post safety sweep.
EDIT_SCAN_RECENT_MESSAGES=20
# Hits pulled from Telegram's global search per tracked username, once per sweep.
# This is the only way to see mentions inside mini-app cards Telethon cannot decode.
# 0 disables the global-search pass.
GLOBAL_SEARCH_LIMIT=40
STARTUP_SCAN_DELAY_SECONDS=8
STARTUP_SCAN_WAIT_SECONDS=30
TELEGRAM_CONNECT_TIMEOUT_SECONDS=30
TELEGRAM_RETRY_DELAY_SECONDS=8
TELEGRAM_RECONNECT_BASE_SECONDS=20
TELEGRAM_RECONNECT_MAX_SECONDS=300
TELEGRAM_RECONNECT_JITTER_SECONDS=15
MARKET_POLL_SECONDS=300
MARKET_ALERT_CHANGE_PCT=5.0
MARKET_RETENTION_DAYS=7
BACKUP_RETENTION=10
PENDING_AUTH_TTL_SECONDS=600

# DB retention / growth control (auto-scan runs this each sweep).
# DB_MAX_SIZE_MB: when the main DB exceeds this, oldest non-favorite/non-win
#   pings are evicted (and VACUUMed) until it fits. 0 disables the size cap.
# DB_ARCHIVE_ENABLED: copy evicted pings to pulse_desk_archive.db before delete.
# ARCHIVE_RETENTION_DAYS: age cap for records INSIDE pulse_desk_archive.db. The
#   file itself is kept; rows older than this are pruned each sweep. 0 = keep forever.
# SCAN_RUNS_RETENTION: keep only the newest N scan_runs rows (running ones spared).
# AUDIT_RETENTION_DAYS: age cap for settings_history / access_audit / giveaway_actions.
DB_MAX_SIZE_MB=1024
DB_ARCHIVE_ENABLED=true
ARCHIVE_RETENTION_DAYS=30
SCAN_RUNS_RETENTION=500
AUDIT_RETENTION_DAYS=90

# Watchdog: alerts the admin via the bot when a critical background job
# (auto-scan, reminders, etc.) dies or stops reporting. Set false to disable.
WATCHDOG_ENABLED=true
WATCHDOG_POLL_SECONDS=60

# Logging.
LOG_LEVEL=INFO
TELETHON_LOG_LEVEL=WARNING

# Keyword lists may contain Russian, Ukrainian and English words.
WIN_KEYWORDS=победитель,выиграл,выиграла,вы выиграли,поздравляем,забрать приз,winner,win,congratulations,переможець,виграв
GIVEAWAY_KEYWORDS=фаст,конкурс,розыгрыш,условия,условие,итоги
JOIN_BUTTON_KEYWORDS=участвовать,participate,join,вступить,зарегистрироваться,register

# Optional custom database location.
PULSE_DB_PATH=

# Optional runtime directories. By default Pulse Desk uses ./data, ./sessions and ./logs.
# Use a unique directory per IP/machine if you run the same Telegram accounts elsewhere.
PULSE_SESSION_DIR=
PULSE_LOG_DIR=

# ── Obsidian "Долги" note two-way sync (all optional) ───────────────────────
# Absolute path to the Долги.md note inside your Obsidian vault. Empty = disabled.
# Example:
# OBSIDIAN_DEBTS_PATH=C:\Users\User\iCloudDrive\iCloud~md~obsidian\shinra ww\3. Recources\23. Утилиты\Долги.md
OBSIDIAN_DEBTS_PATH=
# Turn the background sync loop on (reads the note, reconciles claimed/done with the Debts board).
OBSIDIAN_SYNC_ENABLED=false
# Allow Pulse Desk to WRITE into the note (tick boxes, append newly detected wins).
# Leave false until you have verified read-only behaviour — the file lives in your vault.
OBSIDIAN_SYNC_WRITE=false
# How often (seconds) to poll the note file for changes.
OBSIDIAN_SYNC_POLL_SECONDS=30

# --- Telegram Mini App (bot panel with custom buttons) ---
# Off by default: turning it on starts a Cloudflare quick tunnel that publishes
# MINIAPP_PORT over HTTPS so Telegram can load the panel from a phone. Only the
# Mini App is served on that port — never the dashboard, which stays on PORT
# bound to localhost.
MINIAPP_ENABLED=false
MINIAPP_PORT=8010
# Which tunnel agent publishes MINIAPP_PORT: "tailscale", "ngrok" or "cloudflared".
#   tailscale    the default. `tailscale up` once (browser login, free), then
#                enable Funnel for the tailnet. Stable https://<host>.<tailnet>.ts.net,
#                no domain to buy.
#   ngrok        needs a free account (`ngrok config add-authtoken ...`); the free
#                plan carries one reserved domain, so NGROK_DOMAIN gives a stable
#                address. Windows Defender's PUA protection quarantines the ngrok
#                binary on some machines (this one included).
#   cloudflared  needs no account but mints a new hostname on every restart, and
#                its control host api.trycloudflare.com is blocked on some
#                networks (this one included) — the tunnel then never comes up.
TUNNEL_PROVIDER=tailscale
# Reserved ngrok domain, e.g. pulse-desk.ngrok-free.app. Empty = random each start.
NGROK_DOMAIN=
# Paths or names of the agent binaries. Leave as-is when they are on PATH.
TAILSCALE_BIN=tailscale
NGROK_BIN=ngrok
CLOUDFLARED_BIN=cloudflared
